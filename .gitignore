# Local Node.js dependencies are downloaded when deploying the Cloudflare Worker.
# They should never be committed to GitHub.
worker/node_modules/

# Cloudflare/Wrangler local working files.
worker/.wrangler/

# Local development variables can contain API keys and other secrets.
# Keep example/template files versioned if we add them later.
worker/.dev.vars
worker/.dev.vars.*
worker/.env
worker/.env.*
!worker/.env.example

# Local legal-policy review copies. Keep these out of the public repository.
/Prepared Paws Website Policy Draft.pdf
/Prepared Paws Operating Agreement Draft.pdf
